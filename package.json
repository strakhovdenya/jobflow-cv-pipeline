{
  "name": "jobflow-cv-pipeline",
  "version": "0.1.0",
  "description": "Monorepo root — backend-first AI-assisted CV pipeline for targeted job applications. See apps/api and apps/web.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky",
    "postinstall": "node scripts/setup-metaskills.js",
    "skills:update": "npm update metaskills && node scripts/setup-metaskills.js",
    "test:ralph": "node --test \".claude/ralph/*.test.js\""
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "metaskills": "^1.0.5"
  },
  "lint-staged": {
    "apps/api/{src,libs,test}/**/*.ts": [
      "node apps/api/node_modules/eslint/bin/eslint.js --fix",
      "node apps/api/node_modules/prettier/bin/prettier.cjs --write"
    ],
    "apps/web/src/**/*.{ts,tsx}": [
      "node scripts/lint-staged-web-eslint.js"
    ]
  }
}
