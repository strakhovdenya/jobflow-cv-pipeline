# Dependencies
node_modules/

# Build output
dist/
build/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Coverage
coverage/

# TypeScript incremental build cache
*.tsbuildinfo

# Storage (local artifact files — not committed)
storage/

# OS
.DS_Store
Thumbs.db


# Playwright MCP screenshots/snapshots (local debugging artifacts)
.playwright-mcp/

# Python bytecode cache (e.g. .claude/skills/*/scripts/__pycache__/)
__pycache__/
*.pyc

# metaskills — копии из node_modules/metaskills/skills/<name>, создаются postinstall-скриптом
# scripts/setup-metaskills.js, чтобы Claude Code и автономные агенты видели их как обычные skills
# (сканируют на глубину .claude/skills/<name>/SKILL.md)
.claude/skills/data-structures
.claude/skills/js-data-structures
.claude/skills/js-conventions
.claude/skills/error-handling
.claude/skills/js-gof

# Ralph loop live config/state/lock (see .claude/ralph/README.md and config.example.json)
.claude/ralph/config.json
.claude/ralph/state.json
.claude/ralph/run.lock

# Ralph loop per-issue clones (replaces the old git-worktree approach)
.ralph-runs/

# Personal local Claude Code permissions (never committed, generated per-clone by Ralph too)
.claude/settings.local.json
