*.pyc

# dark-factory — копии базового набора скиллов и агентов и их список, создаются setup
# установленного пакета (postinstall node_modules/dark-factory). Только поимённо: setup не
# принимает маски, а проектные скиллы в .claude/skills остаются tracked.
.claude/.factory-installed.json
.claude/skills/prd
.claude/skills/plan
.claude/skills/issues
.claude/skills/task-lifecycle
.claude/skills/epic-discovery
.claude/skills/adr
.claude/skills/js-conventions
.claude/skills/js-gof
.claude/skills/js-data-structures
.claude/skills/error-handling
.claude/skills/modern-javascript
.claude/skills/data-structures
.claude/agents/research.md
.claude/agents/codebase-scan.md
.claude/agents/verify.md
.claude/agents/pr-writer.md

# Personal Ralph run config/state of the installed package (default .ralph/config.json)
.ralph/

# Ralph loop live config/state/lock (see .claude/ralph/README.md and config.example.json)
.claude/ralph/config.json
.claude/ralph/state.json
.claude/ralph/run.lock

# Ralph loop per-issue clones (replaces the old git-worktree approach)
.ralph-runs/

# Personal local Claude Code permissions (never committed, generated per-clone by Ralph too)
.claude/settings.local.json

# Ralph sandbox integration-test scratch dirs (issue #506)
.ralph-sandbox-tmp/
