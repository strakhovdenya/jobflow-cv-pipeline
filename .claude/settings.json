{
  "permissions": {
    "allow": [
      "Edit(apps/**)",
      "Bash(npm run test*)",
      "Bash(npm run test:e2e*)",
      "Bash(npx prisma *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/task-archive-sync-hook.js || true",
            "statusMessage": "Checking task archive sync..."
          },
          {
            "type": "command",
            "command": "node scripts/git-closure-gate-hook.js",
            "statusMessage": "Checking Task Closure Checklist..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lint-hook.js || true",
            "statusMessage": "Auto-fixing lint..."
          },
          {
            "type": "command",
            "command": "node scripts/typecheck-hook.js || true",
            "statusMessage": "Type-checking..."
          }
        ]
      }
    ]
  }
}
