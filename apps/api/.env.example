# --- PostgreSQL (Docker) ---
POSTGRES_USER=jobflow
POSTGRES_PASSWORD=jobflow_secret
POSTGRES_DB=jobflow_cv
POSTGRES_PORT=5432

# --- NestJS App ---
# Required: full PostgreSQL connection string
DATABASE_URL=postgresql://jobflow:jobflow_secret@localhost:5432/jobflow_cv

# Required: absolute path to artifact storage root
STORAGE_ROOT=/path/to/storage/applications

# Required: shared-secret API key, sent as the X-API-Key header on every
# request except GET /health (single-operator tool — no user accounts)
API_KEY=change-me-to-a-long-random-secret

# Required: root path for knowledge source content files
KNOWLEDGE_SOURCES_ROOT=./knowledge-sources

# Required only for GET /import/scan: absolute path to the legacy
# Company/YYYY.MM.DD/ application folder root to scan (fixed, not caller-supplied,
# to avoid exposing arbitrary filesystem paths over HTTP)
# IMPORT_ROOT=/path/to/legacy/applications

# Optional: server port (default: 3000)
PORT=3000

# Optional: bind address (default: localhost only; use 0.0.0.0 only when network access is intentional)
HOST=127.0.0.1

# Optional: development | production | test (default: none)
NODE_ENV=development

# Optional: log level — trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# Optional: allowed CORS origin (default: * in dev — restrict in prod)
# CORS_ORIGIN=https://your-frontend.example.com

# Optional: rate limiter window in seconds (default: 60)
# THROTTLE_TTL=60

# Optional: max requests per window (default: 100)
# THROTTLE_LIMIT=100

# Optional: max AI step enqueue requests (run-analysis, generate-cv-content, ...)
# per window, counted separately from THROTTLE_LIMIT (default: 10)
# THROTTLE_AI_STEP_LIMIT=10

# --- Redis (Docker) — required: AI steps run as BullMQ background jobs ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Optional BullMQ key prefix (default "bull"); use a distinct one to isolate queues that share a Redis
# QUEUE_PREFIX=jobflow

# --- AI Provider ---
# Which AiProvider implementation to use — fake | openai. Defaults to fake outside production;
# REQUIRED when NODE_ENV=production (the app does not start without it)
AI_PROVIDER=fake

# Required when AI_PROVIDER=openai: OpenAI API key
# OPENAI_API_KEY=sk-your-key-here

# Optional: OpenAI model name (code default: gpt-4o). Recommended per ISSUE-214 calibration
# round 1 (2026-08-23): gpt-5.6-luna — comparable per-call cost to gpt-4o-mini (~$0.02 vs ~$0.015)
# but measurably more disciplined reasoning (fuller must_have enumeration, no observed
# overclaiming/hallucination across the golden-dataset set). See project-management/TEST_LOG.md's
# 2026-08-23 ISSUE-214 entry for the full model comparison.
# OPENAI_MODEL=gpt-5.6-luna

# Optional: per-attempt timeout in ms (default: 120000). A timeout is never retried.
# OPENAI_TIMEOUT_MS=120000
# Optional: retries for errors before generation starts (429, 5xx) only (default: 2)
# OPENAI_MAX_RETRIES=2

# Optional: max_completion_tokens (positive integers). The per-step value wins; steps without
# their own variable use OPENAI_MAX_OUTPUT_TOKENS. Values include reasoning tokens.
# OPENAI_MAX_OUTPUT_TOKENS=50000
# OPENAI_MAX_OUTPUT_TOKENS_PROMPT_1=16000
# OPENAI_MAX_OUTPUT_TOKENS_PROMPT_2=50000
# OPENAI_MAX_OUTPUT_TOKENS_PROMPT_3=10000
# OPENAI_MAX_OUTPUT_TOKENS_PROMPT_5=6000
# OPENAI_MAX_OUTPUT_TOKENS_SKIP_REASON=6000
# OPENAI_MAX_OUTPUT_TOKENS_COVER_LETTER=6000

# Reserved for future step-level provider/model overrides (not read by current code)
# AI_PROVIDER_DEFAULT=openai
# AI_MODEL_DEFAULT=gpt-4o
